rules_version = '2';

// Firebase Console > Firestore Database > Rules > ثم Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function userPath(uid) { return /databases/$(database)/documents/artifacts/hsabat-e34d7/public/data/users/$(uid); }
    function setupPath()   { return /databases/$(database)/documents/artifacts/hsabat-e34d7/public/data/meta/setup; }
    function reqPath(id)   { return /databases/$(database)/documents/artifacts/hsabat-e34d7/public/data/requests/$(id); }
    function chPath(id)    { return /databases/$(database)/documents/artifacts/hsabat-e34d7/public/data/channels/$(id); }

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }
    function verified() { return request.auth.token.email_verified == true; }
    function profile()  { return get(userPath(request.auth.uid)).data; }

    // عضو: له مستند مستخدم وحسابه غير موقوف.
    // لا يوجد نظام حسابات معلّقة؛ أي حساب جديد يعمل مباشرة، والأدمن يستطيع إيقافه (status = rejected).
    function isMember() {
      return signedIn() && exists(userPath(request.auth.uid)) && profile().get('status', 'active') != 'rejected';
    }
    function isOwner() { return isMember() && profile().role == 'owner'; }

    function profileShape() {
      return request.resource.data.keys().hasOnly(['name', 'email', 'role', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.name.split(' ').size() >= 4
        && request.resource.data.email == request.auth.token.email;
    }

    // علامة "تم إعداد النظام": تُنشأ مرة واحدة فقط عند إنشاء أول مالك
    match /artifacts/hsabat-e34d7/public/data/meta/setup {
      allow get: if true;
      allow create: if signedIn()
        && !exists(setupPath())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt']);
    }

    // حسابات المستخدمين
    match /artifacts/hsabat-e34d7/public/data/users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if signedIn() && (
        isOwner()
        // تسجيل ذاتي مباشر: مُدخل بيانات فقط، ولا يستطيع منح نفسه دور المالك
        || (request.auth.uid == uid && profileShape()
            && request.resource.data.role == 'submitter' && request.resource.data.status == 'active')
        // أول مالك للنظام
        || (request.auth.uid == uid && profileShape()
            && request.resource.data.role == 'owner' && request.resource.data.status == 'active'
            && !exists(setupPath()) && getAfter(setupPath()).data.ownerUid == uid)
      );
      allow update: if isOwner();
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // دفتر المعاملات الرئيسي: المالك يرى الكل، والمُدخل يرى معاملاته فقط
    match /artifacts/hsabat-e34d7/public/data/transactions/{id} {
      allow read: if isOwner() || (isMember() && resource.data.uid == request.auth.uid);

      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
             ['type', 'amount', 'reference', 'notes', 'category', 'createdAt', 'status', 'submittedBy', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['add', 'subtract']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 4
        && request.resource.data.reference.size() <= 40
        && request.resource.data.status == (isOwner() ? 'approved' : 'pending');

      allow update: if isOwner();
      allow delete: if isOwner()
        || (isMember() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // طلبات فتح القنوات (بالبريد الإلكتروني)
    match /artifacts/hsabat-e34d7/public/data/requests/{rid} {
      allow create: if isMember() && verified()
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'fromEmail', 'toEmail', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.fromName == profile().name
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail.size() <= 120
        && request.resource.data.toEmail != request.auth.token.email
        && request.resource.data.status == 'pending';

      allow read: if isMember() && verified()
        && (resource.data.fromUid == request.auth.uid || resource.data.toEmail == request.auth.token.email);

      // المستلم يقبل/يرفض، والمرسل يلغي. لا يُعدَّل شيء آخر.
      allow update: if isMember() && verified()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && (
          (resource.data.toEmail == request.auth.token.email && request.resource.data.status in ['accepted', 'rejected'])
          || (resource.data.fromUid == request.auth.uid && request.resource.data.status == 'cancelled')
        );

      allow delete: if false;
    }

    // القنوات
    match /artifacts/hsabat-e34d7/public/data/channels/{cid} {
      allow read: if isMember() && verified() && request.auth.uid in resource.data.members;

      // لا تُنشأ إلا عند قبول طلب موجّه لي (نفس العملية الذرّية)
      allow create: if isMember() && verified()
        && request.resource.data.keys().hasOnly(['members', 'names', 'emails', 'createdAt'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll([get(reqPath(cid)).data.fromUid, request.auth.uid])
        && get(reqPath(cid)).data.status == 'pending'
        && get(reqPath(cid)).data.toEmail == request.auth.token.email
        && getAfter(reqPath(cid)).data.status == 'accepted';

      allow update, delete: if false;

      // معاملات القناة المشتركة
      match /entries/{eid} {
        function inChannel() { return isMember() && verified() && request.auth.uid in get(chPath(cid)).data.members; }

        allow read: if inChannel();

        allow create: if inChannel()
          && request.resource.data.keys().hasOnly(['creatorUid', 'creatorName', 'type', 'reference', 'amount', 'notes', 'createdAt', 'status'])
          && request.resource.data.creatorUid == request.auth.uid
          && request.resource.data.creatorName == profile().name
          && request.resource.data.type == 'add'
          && request.resource.data.reference is string
          && request.resource.data.reference.matches('^[0-9]{4,20}$')
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000000
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.status == 'pending';

        // الطرف الآخر فقط يؤكد أو يرفض
        allow update: if inChannel()
          && resource.data.creatorUid != request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['confirmed', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);

        // صاحب المعاملة يسحبها قبل التأكيد
        allow delete: if inChannel()
          && resource.data.creatorUid == request.auth.uid
          && resource.data.status == 'pending';
      }
    }
  }
}
